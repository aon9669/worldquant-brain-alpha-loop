<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.aon.wqloop</string>
<key>ProgramArguments</key><array><string>/usr/bin/caffeinate</string><string>-is</string><string>/bin/bash</string><string>__REPO_DIR__/wq_loop/loop.sh</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>60</integer>
<key>StandardOutPath</key><string>__REPO_DIR__/wq_loop/loop.log</string>
<key>StandardErrorPath</key><string>__REPO_DIR__/wq_loop/loop.log</string>
</dict></plist>

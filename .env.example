# Copy to ~/.wq_env (outside the repo) and fill in. Never commit real values.
# loop.sh sources ${WQ_ENV_FILE:-$HOME/.wq_env}.
WQB_EMAIL=
WQB_PASSWORD=
# Optional: reuse an existing BRAIN session cookie instead of logging in
WQB_COOKIE_HEADER=

# Optional overrides
WQ_ENV_FILE=
WQ_HOME=
LLMQ_HOME=
CLAUDE_BIN=
WQ_LLM_BACKEND=agy
WQ_AGY_MODEL=gemini-3.8-flash-high
WQ_LLM_QUEUE=1
